# Generate unique secrets before starting services; never commit .env.
SECRET_KEY=
JUDGE_AUTH_TOKEN=
JUDGE_SECRET_TOKEN=
DJANGO_SECRET_KEY=
JWT_SECRET=
DB_PASSWORD=
DEBUG=False
ALLOWED_HOSTS=codeprooj.com,www.codeprooj.com,backend
CORS_ALLOWED_ORIGINS=https://codeprooj.com,https://www.codeprooj.com
CSRF_TRUSTED_ORIGINS=https://codeprooj.com,https://www.codeprooj.com
CORS_ALLOW_ALL=False

# Database (PostgreSQL for Docker Compose)
DB_HOST=
DB_PORT=5432
DB_USER=coding_app
DB_NAME=coding_platform

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# Services
PORT=8888
CODEPRO_HTTP_PORT=8080
DJANGO_BACKEND_HOST=127.0.0.1
DJANGO_BACKEND_PORT=8000
JUDGE_SERVER_URL=http://127.0.0.1:9999
JUDGE_SERVER_PORT=9999
JUDGE_MAX_WORKERS=4
SANDBOX_MEMORY_LIMIT_MB=512
SANDBOX_TIME_LIMIT_SEC=5
STORAGE_ROOT=storage
