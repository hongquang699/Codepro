# Generate unique secrets before starting services; never commit .env.
SECRET_KEY=
JUDGE_AUTH_TOKEN=
JUDGE_SECRET_TOKEN=
DJANGO_SECRET_KEY=
JWT_SECRET=
TESTCASE_ENCRYPTION_KEY=
DB_PASSWORD=
DEBUG=False
ALLOWED_HOSTS=codeprooj.com,www.codeprooj.com,backend
CORS_ALLOWED_ORIGINS=https://codeprooj.com,https://www.codeprooj.com
CSRF_TRUSTED_ORIGINS=https://codeprooj.com,https://www.codeprooj.com
CORS_ALLOW_ALL=False

# Database (PostgreSQL for Docker Compose)
DB_HOST=
DB_PORT=5432
DB_USER=coding_app
DB_NAME=coding_platform

# Required for registration and password reset email delivery.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@codeprooj.com

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0
JUDGE_QUEUE_REDIS_URL=redis://redis:6379/2

# Versioned Problem Storage. Public endpoint must be reachable by an editor's browser.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_PORT=9000
PROBLEM_STORAGE_PUBLIC_ENDPOINT=http://127.0.0.1:9000
PROBLEM_STORAGE_ENDPOINT=http://127.0.0.1:9000
PROBLEM_STORAGE_ACCESS_KEY=
PROBLEM_STORAGE_SECRET_KEY=
PROBLEM_STORAGE_PRIVATE_BUCKET=problem-private
PROBLEM_STORAGE_PUBLIC_BUCKET=problem-public
PROBLEM_STORAGE_QUEUE_URL=http://127.0.0.1:3010
PROBLEM_STORAGE_INTERNAL_TOKEN=

# Services
PORT=8888
CODEPRO_HTTP_PORT=8080
DJANGO_BACKEND_HOST=127.0.0.1
DJANGO_BACKEND_PORT=8000
JUDGE_SERVER_URL=http://127.0.0.1:9999
JUDGE_SERVER_PORT=9999
JUDGE_MAX_WORKERS=4
SANDBOX_MEMORY_LIMIT_MB=512
SANDBOX_TIME_LIMIT_SEC=5
STORAGE_ROOT=storage

# Optional internal code similarity service. Compose: http://ai-similarity:8010
# Leave URL empty to retain the existing local anti-cheat implementation.
AI_SIMILARITY_URL=
AI_SIMILARITY_TOKEN=
